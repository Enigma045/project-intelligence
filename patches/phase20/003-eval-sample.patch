@@NEW
if lg := kv["lang"]; lg != "" {
    keep := edges[:0]
    for _, e := range edges {
      if eval.LangOf(e.File) == lg {
        keep = append(keep, e)
      }
    }
    edges = keep
  }
  picked := eval.SampleEdges(edges, types, n, seed+mode, skip)
@@END
